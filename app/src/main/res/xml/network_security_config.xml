<?xml version="1.0" encoding="utf-8"?>
<!-- Erlaubt http:// für den Server im Heimnetz bzw. im Tailscale-Netz.
     Über das Internet bitte nur https:// verwenden. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
